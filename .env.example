# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env        (macOS / Linux / Git Bash)
#   copy .env.example .env      (Windows Command Prompt)
# ".env" is listed in .gitignore, so it will NOT be committed.
# ".env.example" has fake placeholder values and IS committed.

# ---------- Database (PostgreSQL) ----------
DATABASE_NAME=transithub
DATABASE_USERNAME=transithub_user
DATABASE_PASSWORD=change_me_to_a_strong_password
# Spring Boot reads this one. Must match the values above.
DATABASE_URL=jdbc:postgresql://localhost:5432/transithub

# ---------- Security ----------
# Secret used to sign login tokens (JWT). Use a long random string (32+ characters).
# Example of generating one:  openssl rand -base64 48
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
# How long a login token stays valid, in milliseconds (7200000 = 2 hours)
JWT_EXPIRATION_MS=7200000

# ---------- Web ----------
# The address of the React app, so the backend allows its requests (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Who can reach the backend: 127.0.0.1 = only this computer, 0.0.0.0 = every device on your network
SERVER_ADDRESS=127.0.0.1

# ---------- Demo accounts (development only) ----------
# On startup the backend creates one admin and one normal user if they do not exist.
# Choose your own passwords (8+ characters, at least one letter and one number).
# If a password is left empty, that account is NOT created.
DEMO_ADMIN_EMAIL=admin@routa.local
DEMO_ADMIN_PASSWORD=
DEMO_USER_EMAIL=user@routa.local
DEMO_USER_PASSWORD=
